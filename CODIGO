# Estaciones y tiempos base (minutos)
rutas = {
    'A': [('B', 8), ('C', 12)],
    'B': [('A', 8), ('C', 6)],
    'C': [('B', 6), ('D', 4), ('E', 7)],
    'D': [('C', 4)],
    'E': [('C', 7)]
}

# Coordenadas (x, y) de las estaciones
estaciones = {
    'A': (0, 0), 'B': (2, 3), 'C': (5, 2), 'D': (6, 5), 'E': (8, 1)
}

# Reglas Lógicas
def aplicarReglas(origen, destino, tiempoBase, esTransbordo=False, trafico=1.0):
    tiempoFinal = tiempoBase

    # Regla 1: Si requiere transbordo entre líneas, sumar 5 minutos
    if esTransbordo:
        tiempoFinal += 5.0

    # Regla 2: Si hay tráfico, multiplicar el tiempo
    if trafico > 1.0:
        tiempoFinal *= trafico

    return tiempoFinal

# ====================
# PRUEBAS MÓDULO 1
# ====================
print("=== DEMOSTRACIÓN DE LA BASE DE CONOCIMIENTO Y REGLAS ===")
tiempoNormal = aplicarReglas('A', 'B', 8.0, esTransbordo=False, trafico=1.0)
tiempoConTransbordo = aplicarReglas('A', 'B', 8.0, esTransbordo=True, trafico=1.0)
tiempoConTrafico = aplicarReglas('A', 'B', 8.0, esTransbordo=False, trafico=1.3)

print(f"Tiempo base en tramo A -> B: 8.0 minutos")
print(f"1. Con Regla Normal: {tiempoNormal:.2f} minutos")
print(f"2. Con Regla de Transbordo (+5 min): {tiempoConTransbordo:.2f} minutos")
print(f"3. Con Regla de Tráfico Alto (+30%): {tiempoConTrafico:.2f} minutos")

import math
import heapq

# Heurística: Distancia euclidiana en línea recta
def heuristica(nodoActual, nodoDestino):
    x1, y1 = estaciones[nodoActual]
    x2, y2 = estaciones[nodoDestino]
    return math.sqrt((x2 - x1)**2 + (y2 - y1)**2)

# Algoritmo de Búsqueda A*
def buscarRuta(origen, destino, trafico=1.0):
    if origen not in estaciones or destino not in estaciones:
        return None, float('inf')

    cola = [(0 + heuristica(origen, destino), 0, origen, [origen])]
    visitados = set()

    while cola:
        f, g, actual, camino = heapq.heappop(cola)

        if actual == destino:
            return camino, g

        if actual in visitados:
            continue
        visitados.add(actual)

        for vecino, tiempoBase in rutas.get(actual, []):
            if vecino not in visitados:
                # Función creada en el módulo 1
                tiempoTramo = aplicarReglas(actual, vecino, tiempoBase, trafico=trafico)
                nuevoG = g + tiempoTramo
                nuevoF = nuevoG + heuristica(vecino, destino)
                heapq.heappush(cola, (nuevoF, nuevoG, vecino, camino + [vecino]))

    return None, float('inf')

# ====================
# PRUEBAS MÓDULO 2
# ====================
print("=== SISTEMA INTELIGENTE DE NAVEGACIÓN ===")
origenUser = input("Ingrese estación de origen (A, B, C, D, E): ").strip().upper()
destinoUser = input("Ingrese estación de destino (A, B, C, D, E): ").strip().upper()

caminoOptimo, tiempoCalculado = buscarRuta(origenUser, destinoUser, trafico=1.2)

print("\n--- RESULTADO OBTENIDO CON A* ---")
if caminoOptimo:
    print(f"Ruta óptima calculada: {' -> '.join(caminoOptimo)}")
    print(f"Tiempo estimado total: {tiempoCalculado:.2f} minutos")
else:
    print("Estación no válida.")